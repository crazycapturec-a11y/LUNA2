# Optional overrides — service availability is not guaranteed without them.

# YouTube
# Datacenter IPs (Vercel, AWS, …) sometimes get HTTP 403 from YouTube when a
# proof-of-origin (PO) token is missing. If downloads start failing with 403,
# supply one of these:
# YT_PO_TOKEN=<po token tied to the video/session>
# YT_VISITOR_DATA=<visitor data string>
# YT_COOKIE=<full cookie header from a logged-in browser>

# Optional separate YouTube worker (both required to enable it).
# See services/youtube-worker/README.md. Never commit real secrets.
# YOUTUBE_WORKER_URL=https://your-worker-host.example
# YOUTUBE_WORKER_SECRET=<same private worker secret, at least 32 bytes>

# Instagram (server-side only; never commit or share real values)
# Choose ONE: a full Cookie header or just the sessionid value. IG_COOKIES wins
# if both are present. Set the secret in your hosting dashboard, not this file.
# IG_COOKIES=sessionid=<value>; csrftoken=<value>; ds_user_id=<value>
# IG_SESSION_ID=<instagram sessionid value only>
